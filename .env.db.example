# ============================================================
# GoTranscribeSrv — DB VM configuration
# ============================================================
# Copy to .env next to docker-compose.db.yml and edit.
# Compose reads .env automatically.
#
# The credentials below must match what every node has inside
# its DATABASE_URL (in each mini's .env).
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=transcribesrv
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=transcribesrv

# ── Docker log rotation ────────────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
