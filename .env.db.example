# ============================================================
# GoTranscribeSrv — DB VM configuration
# ============================================================
# Copy to .env next to docker-compose.db.yml and edit.
# Compose reads .env automatically.
#
# The credentials below must match what every node has inside
# its DATABASE_URL (in each mini's .env).
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=transcribesrv
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=transcribesrv

# ── Docker log rotation ────────────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ── Caddy trusted proxies (client IP forwarding) ──────────
# Which proxies in front of Caddy may set X-Forwarded-For.
# private_ranges = trust any internal (RFC1918/loopback) proxy — the
# right default since Caddy is only reachable internally via nginx.
# To restrict, set your front proxy's CIDR, e.g.:
#   TRUSTED_PROXIES=10.40.50.104/32
TRUSTED_PROXIES=private_ranges
