# ============================================================
# GoTranscribeSrv — Master Configuration
# ============================================================
# Copy this file to .env and edit values as needed.
# Docker Compose reads this file automatically.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000
ENVIRONMENT=development
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=transcribesrv
POSTGRES_PASSWORD=changeme_db_password
POSTGRES_DB=transcribesrv
DATABASE_URL=postgres://transcribesrv:changeme_db_password@db:5432/transcribesrv?sslmode=disable

# ── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Python Sidecar (TTS, Diarization, LLM) ─────────────────
# Co-located: Sidecar runs on the same host (default).
#   For Docker: use host.docker.internal to reach native sidecar.
#   For manual:  use localhost.
SIDECAR_URL=http://host.docker.internal:8100
SIDECAR_WS_URL=ws://host.docker.internal:8100

# ── Node.js ASR Sidecar (CoreML/ANE) ───────────────────────
# Runs Parakeet TDT via CoreML on Apple's Neural Engine.
ASR_SIDECAR_URL=http://host.docker.internal:8101
ASR_SIDECAR_WS_URL=ws://host.docker.internal:8101

# ── Models ──────────────────────────────────────────────────
ASR_MODEL=mlx-community/parakeet-tdt-0.6b-v3
ENABLE_DIARIZATION=true
ENABLE_TTS=true

# ── LLM Processing (opt-in, requires ~4.5 GB extra RAM) ────
ENABLE_LLM=false
LLM_MODEL=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit

# HuggingFace model cache — shared between host and Docker
# HF_HOME=~/.cache/huggingface

# ── Rate Limits (requests/minute) ──────────────────────────
RATE_LIMIT_FREE=20
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=0
