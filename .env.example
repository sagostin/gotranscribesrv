# ============================================================
# GoTranscribeSrv — Master Configuration
# ============================================================
# Copy this file to .env and edit values as needed.
# Docker Compose reads this file automatically.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000
ENVIRONMENT=development
LOG_LEVEL=info
REGISTRATION_ENABLED=false

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=transcribesrv
POSTGRES_PASSWORD=changeme_db_password
POSTGRES_DB=transcribesrv
DATABASE_URL=postgres://transcribesrv:changeme_db_password@db:5432/transcribesrv?sslmode=disable

# ── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Audio Sidecar (ASR, VAD, Diarization, TTS — CoreML/ANE) ─
# Runs all audio AI models on Apple Neural Engine via FluidAudio.
#   For Docker: use host.docker.internal to reach native sidecar.
#   For manual:  use localhost.
#
# Backward-compat: SWIFT_SIDECAR_URL / SWIFT_SIDECAR_WS_URL are still
# honored as fallbacks during the rename from `swift-sidecar` to
# `audio-sidecar`. New deployments should set AUDIO_SIDECAR_URL /
# AUDIO_SIDECAR_WS_URL.
AUDIO_SIDECAR_URL=http://host.docker.internal:8101
AUDIO_SIDECAR_WS_URL=ws://host.docker.internal:8101

# ── LLM Sidecar (chat, completions, embeddings, images — CoreML/ANE) ─
# Vapor sidecar speaking OpenAI (/v1/chat/completions, /v1/completions,
# /v1/embeddings, /v1/images/generations, /v1/models) and Anthropic
# (/v1/messages) dialects. The Go server proxies these routes with auth,
# rate limiting, and per-model token usage tracking.
#   For Docker: use host.docker.internal to reach the native sidecar.
#   For manual:  use http://127.0.0.1:8080.
ENABLE_LLM=true
LLM_SIDECAR_URL=http://host.docker.internal:8080

# ── Realtime Speech-to-Speech (WS /v1/realtime, S2S mode) ──
# Full OpenAI Realtime speech-to-speech: ASR → LLM → TTS orchestrated by
# the Go server, with turn-taking, barge-in, and client-side tool calling.
# Requires ENABLE_LLM=true and the LLM sidecar running. See docs/realtime.md.
#   Off by default — transcription sessions on /v1/realtime work regardless.
#   Clients select S2S by connecting with ?model=gpt-realtime (or any
#   gpt-realtime* name). Requires `make llm-vendor` + a chat model loaded.
REALTIME_S2S_ENABLED=false
# LLM model id (from the sidecar-llm registry) used for S2S turns:
REALTIME_S2S_MODEL=mistral-7b-int4
# PocketTTS voice for spoken responses (17 built-ins: alba, jane, charles, …):
REALTIME_S2S_VOICE=default
# Per-turn response cap (lower = snappier turns, less rambling):
REALTIME_S2S_MAX_TOKENS=300
REALTIME_S2S_TEMPERATURE=0.7
# Barge-in: user speech cancels the in-flight assistant response:
REALTIME_S2S_INTERRUPTIONS=true

# ── Models ──────────────────────────────────────────────────
ASR_MODEL=mlx-community/parakeet-tdt-0.6b-v3
ENABLE_DIARIZATION=true
ENABLE_TTS=true

# ── TTS backend selection (Kokoro vs PocketTTS) ─────────────
# Two TTS engines ship with the audio sidecar:
#   pocket (PocketTTS — supports streaming + voice cloning; English)
#   kokoro (Kokoro — higher quality, multilingual EN/Mandarin/JP; batch only)
#
# Defaults below preserve prior behavior — they only take effect if you
# uncomment and change them. Existing deployments see no change.
#
# Sidecar: default for /synthesize when ?backend= isn't sent.
# Back-compat: Go /api/v1/tts is hardcoded to "pocket" regardless of this.
# SIDECAR_TTS_DEFAULT_BACKEND=pocket
#
# Sidecar: default for /synthesize/stream. Only "pocket" is honored —
# anything else logs a startup warning and falls back to "pocket"
# (Kokoro has no streaming API in FluidAudio 0.15.5).
# SIDECAR_TTS_STREAM_BACKEND=pocket
#
# Go: default for /v1/audio/speech when the request's `model` is omitted
# or unrecognized. Recognized models (tts-1, tts-1-hd, gpt-4o-mini-tts,
# kokoro, …) still pin to their specific backend — this only affects
# fallback resolution. New endpoint, no impact on existing deployments.
# TTS_DEFAULT_BACKEND=kokoro

# ── Real-time streaming ASR engine ──────────────────────────
# Default streaming engine for the realtime WS endpoints
# (/stream/realtime, /v2/listen, /v1/realtime). Cache-aware streaming
# ASR with turn-taking events — distinct from the buffered /ws/asr
# pseudo-streaming route. Back-compat: only takes effect if uncommented.
#
# SIDECAR_REALTIME_ENGINE=eou-320
#
# Valid values (see docs/api.md for the full engine table):
#   eou-160            — Parakeet EOU 120M, ~160ms (lowest latency)
#   eou-320            — Parakeet EOU 120M, ~320ms (default; built-in EOU)
#   eou-1280           — Parakeet EOU 120M, ~1.28s (high throughput)
#   nemotron-560       — Nemotron 0.6B, ~560ms (higher accuracy)
#   nemotron-1120      — Nemotron 0.6B, ~1.12s
#   nemotron-2240      — Nemotron 0.6B, ~2.24s (highest Nemotron accuracy)
#   unified-320        — Parakeet Unified 0.6B, ~320ms (multilingual; best for non-English)
#   unified-640        — Parakeet Unified 0.6B, ~640ms
#   unified-1120       — Parakeet Unified 0.6B, ~1.12s
#   unified-2080       — Parakeet Unified 0.6B, ~2.08s
#
# Switching engines triggers a one-time HuggingFace download (~100–800 MB)
# on the first session that uses the new engine.

# ── Inverse Text Normalization (ITN) ────────────────────────
# Converts spoken-form ASR output to written form in the audio sidecar.
# "one two five O" -> "1250", "five dollars and fifty cents" -> "$5.50",
# "january fifth twenty twenty five" -> "January 5, 2025".
# ON BY DEFAULT. Set to false to disable globally.
# Per-request override: pass ?itn=false (or form field itn=false).
# ENABLE_ITN=true

# ── Rate Limits (requests/minute) ──────────────────────────
RATE_LIMIT_FREE=20
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=0

# ── Prometheus Metrics ─────────────────────────────────────
# Set to false to completely disable metrics collection (no
# collectors registered, /metrics returns 404).
METRICS_ENABLED=true
METRICS_PATH=/metrics
#
# Metric families exposed when enabled:
#   gotranscribesrv_http_requests_total           — HTTP requests by method/path/status
#   gotranscribesrv_http_request_duration_seconds  — Request latency histogram
#   gotranscribesrv_http_requests_per_minute       — Requests in last 60s window
#   gotranscribesrv_asr_requests_total             — ASR requests by endpoint/diarized
#   gotranscribesrv_asr_audio_duration_seconds_total — Total audio processed (seconds)
#   gotranscribesrv_asr_audio_minutes_total        — Total audio processed (minutes)
#   gotranscribesrv_asr_processing_duration_seconds — ASR processing latency
#   gotranscribesrv_asr_realtime_factor            — Audio/processing time ratio
#   gotranscribesrv_tts_requests_total             — TTS syntheses by voice
#   gotranscribesrv_tts_duration_seconds           — TTS processing latency
#   gotranscribesrv_sidecar_request_duration_seconds — Sidecar round-trip latency
#   gotranscribesrv_sidecar_errors_total           — Sidecar error counts
#   gotranscribesrv_auth_attempts_total            — Auth attempts by method/result
#   gotranscribesrv_rate_limit_rejections_total    — Rate limit 429s by tier
#   gotranscribesrv_active_websocket_connections   — Live WS connections
#   gotranscribesrv_active_users                   — Distinct users in last 60s
#   gotranscribesrv_build_info                     — Static build metadata

# ── Loki Logging (optional) ────────────────────────────────
# Set LOKI_ENABLED=true to ship structured events to Grafana Loki
# in addition to stdout. Non-blocking; drops events on channel
# full rather than stalling the request path. Auth is HTTP Basic.
LOKI_ENABLED=false
LOKI_PUSH_URL=http://loki:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_JOB=gotranscribesrv
SERVER_ID=node-1

# ── PII Redaction in Logs (Loki + stdout) ─────────────────────
# Replaces detected PII entities in `transcript` / `prompt`
# log fields BEFORE they ship to stdout or Loki. The HTTP response
# body is NEVER modified — callers still receive the raw transcript.
#
# Uses Microsoft Presidio (mcr.microsoft.com/presidio-analyzer).
# Setup paths:
#   • `make up` (recommended) — docker-compose.yml starts the
#     `presidio-analyzer` container automatically. Use:
#         PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
#     (Docker-internal DNS — the default below).
#   • Native / non-compose — start the container manually with
#         make presidio-up
#     then override to:
#         PRESIDIO_ANALYZER_URL=http://localhost:5002
#   • Centralized across clusters — point at any external Presidio
#     service:
#         PRESIDIO_ANALYZER_URL=https://presidio.internal.company.com
#     and skip the local container entirely.
#
# ON BY DEFAULT. Set ENABLE_PII=false to log raw transcript text.
#
# When ENABLE_PII=true and the analyzer is unreachable, the affected
# log field is replaced with the literal "<REDACTED-ERROR>" and a
# PII_REDACTOR_ERROR event is emitted. Operators see this in
# gotranscribesrv_pii_errors_total. The HTTP response body is
# unaffected — clients still get the raw transcript.
ENABLE_PII=true
# ↓ Default targets the docker-compose service name. For native setups,
#   change to http://localhost:5002 (after `make presidio-up`).
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_TIMEOUT_MS=3000
# Comma-separated Presidio entity types to detect. Leave empty to
# use the built-in default set: PERSON, EMAIL_ADDRESS, PHONE_NUMBER,
# CREDIT_CARD, US_SSN, IP_ADDRESS, IBAN_CODE, URL, DATE_TIME, LOCATION.
PII_ENTITIES=
# Minimum Presidio confidence score to consider a detection (0.0–1.0).
PII_SCORE_THRESHOLD=0.6

# ── Docker log rotation ────────────────────────────────────
# Per-service stdout/stderr is capped at LOG_MAX_SIZE × LOG_MAX_FILE
# (e.g. 10m × 3 = ~30 MB per container). Prevents a runaway logging
# loop from filling the host disk. Only affects `make up` (Docker
# Compose); logs from native sidecars (Swift/Python) are unaffected.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
