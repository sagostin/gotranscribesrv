# ============================================================
# GoTranscribeSrv — Caddy load balancer (runs on the DB VM)
# ============================================================
# LAN/internal mode: plain HTTP on port 8030. Clients call
#   http://<db-vm-ip-or-lan-hostname>:8030/...
# and Caddy spreads requests across the Mac mini nodes.
#
# Setup:  cp Caddyfile.example Caddyfile   # then edit the `to` list
# (The real Caddyfile is gitignored — your node IPs stay uncommitted.)
#
# To add/remove a node: edit the `to` list below, then:
#   docker compose -f docker-compose.db.yml exec caddy \
#     caddy reload --config /etc/caddy/Caddyfile
# (zero-downtime reload)
# ============================================================

# ── Client IP forwarding ───────────────────────────────────
# reverse_proxy sets X-Forwarded-For (client IP chain), X-Forwarded-Proto
# and X-Forwarded-Host on every request. The Go server already trusts
# X-Forwarded-For (Fiber ProxyHeader config), so logs and rate limiting
# see real client IPs.
#
# IMPORTANT — Caddy sits BEHIND our outside nginx: by default Caddy
# DISCARDS incoming X-Forwarded-* headers from any peer it doesn't trust
# (anti-spoofing), replacing them with the connecting proxy's IP — so the
# Go server would log the nginx/LB IP instead of the real client.
# trusted_proxies below declares which upstream proxies may set them.
#
# Default: private_ranges — trust ANY internal (RFC1918/loopback) proxy.
# Safe here because Caddy is only reachable on the internal network; the
# only internet-facing hop is the outside nginx.
#
# To RESTRICT which sources may forward client IPs (optional hardening),
# set TRUSTED_PROXIES in .env to a single CIDR of your front proxy, e.g.:
#   TRUSTED_PROXIES=10.40.50.104/32
# (For multiple ranges, edit this line directly — an env var value with
# spaces is substituted as a single Caddyfile token.)
# Requires Caddy ≥ 2.7.

# Global options: generous listener timeouts for long-running uploads /
# transcription requests. (reverse_proxy itself has no response timeout.)
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		timeouts {
			read_body 5m
			idle 10m
		}
	}
}

:8030 {
	reverse_proxy {
		# ── Mac mini nodes ─────────────────────────────────────
		# One entry per mini: <LAN IP>:<published server port>.
		to 192.168.1.11:3000
		to 192.168.1.12:3000
		# to 192.168.1.13:3000

		# least_conn routes new requests to the node with the fewest
		# in-flight requests — best fit for long transcription jobs
		# and long-lived WebSocket connections.
		lb_policy least_conn

		# Active health checks: Caddy polls /health on every node and
		# automatically stops routing to a mini that is down, then
		# re-adds it when it recovers (e.g. after a power outage).
		health_uri /health
		health_interval 10s
		health_timeout 3s
		health_status 2xx

		# Mark a node down after this long of consecutive failures.
		fail_duration 30s

		# Transcription of large files can take a while — don't let
		# the proxy give up early on a healthy-but-busy node.
		lb_try_duration 30s
		lb_try_interval 250ms

		# Optional: also pass the client IP as X-Real-IP upstream.
		# (X-Forwarded-For is always sent; enable only if you want both.)
		# header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}

# ── Optional: TLS variant ──────────────────────────────────
# Replace the `:8030` site above with ONE of these if you later
# want encryption:
#
# 1) Public domain + automatic Let's Encrypt (needs 80/443 open
#    to the internet and DNS pointing at this VM):
#
# api.example.com {
# 	reverse_proxy { ...same block as above... }
# }
#
# 2) Internal CA (encrypted without a public domain — clients
#    must trust Caddy's root cert, exportable from the caddy_data
#    volume at pki/authorities/local/root.crt):
#
# https://transcribe.lan {
# 	tls internal
# 	reverse_proxy { ...same block as above... }
# }
