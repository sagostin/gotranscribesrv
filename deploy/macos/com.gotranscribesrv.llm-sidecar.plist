<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GoTranscribeSrv — Python sidecar (LLM only — MLX)
  LaunchAgent: starts at login (pair with auto-login for headless minis)
  and restarts automatically if it crashes.

  Only needed on minis where ENABLE_LLM=true — skip otherwise.

  SETUP: replace __REPO_PATH__ with the absolute repo path, e.g.
    sed -i '' 's|__REPO_PATH__|/Users/transcribe/gotranscribesrv|g' \
      com.gotranscribesrv.llm-sidecar.plist

  Create the venv + download models FIRST:
    make setup
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.gotranscribesrv.llm-sidecar</string>

	<key>ProgramArguments</key>
	<array>
		<string>__REPO_PATH__/sidecar/.venv/bin/python3</string>
		<string>__REPO_PATH__/sidecar/main.py</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__REPO_PATH__/sidecar</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
		<!-- Uncomment to pin the HuggingFace model cache location: -->
		<!--
		<key>HF_HOME</key>
		<string>__REPO_PATH__/.cache/huggingface</string>
		-->
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>__REPO_PATH__/deploy/macos/logs/llm-sidecar.out.log</string>
	<key>StandardErrorPath</key>
	<string>__REPO_PATH__/deploy/macos/logs/llm-sidecar.err.log</string>
</dict>
</plist>
