# ============================================================
# GoTranscribeSrv — NODE configuration (one per Mac mini)
# ============================================================
# Copy to .env next to docker-compose.node.yml and edit.
# Compose reads .env automatically.
#
# SHARED VALUES (must be IDENTICAL on every node):
#   DATABASE_URL, JWT_SECRET, POSTGRES credentials inside DATABASE_URL
# PER-NODE VALUES (must be UNIQUE per mini):
#   SERVER_ID
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000
ENVIRONMENT=production
LOG_LEVEL=info
REGISTRATION_ENABLED=false

# ── Database (on the DB VM) ─────────────────────────────────
# Replace 192.168.1.10 with your DB VM's LAN IP/hostname.
# User/password/db name must match the DB VM's .env.
DATABASE_URL=postgres://transcribesrv:CHANGE_ME_DB_PASSWORD@192.168.1.10:5432/transcribesrv?sslmode=disable

# ── JWT ─────────────────────────────────────────────────────
# Generate ONCE with: openssl rand -hex 32
# Then use the SAME value on every node — this is what makes a
# token issued by node A valid on node B.
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING_SHARED_ON_ALL_NODES
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Node identity (UNIQUE per mini — e.g. node-1, node-2) ──
# Tags Loki events (server_id label) so you can filter logs per mini.
SERVER_ID=node-1

# ── Audio Sidecar (native, launchd — CoreML/ANE) ────────────
# Backward-compat: SWIFT_SIDECAR_URL / SWIFT_SIDECAR_WS_URL still work.
AUDIO_SIDECAR_URL=http://host.docker.internal:8101
AUDIO_SIDECAR_WS_URL=ws://host.docker.internal:8101

# ── LLM Sidecar (native, launchd — chat/embeddings/images) ──
# OpenAI + Anthropic dialects, proxied by the Go server with auth,
# rate limiting, and per-model token usage tracking.
ENABLE_LLM=true
LLM_SIDECAR_URL=http://host.docker.internal:8080

# ── Models ──────────────────────────────────────────────────
ASR_MODEL=mlx-community/parakeet-tdt-0.6b-v3
ENABLE_DIARIZATION=true
ENABLE_TTS=true

# ── TTS backend selection (Kokoro vs PocketTTS) ─────────────
# These env vars are read by the NATIVE audio sidecar (launchd-managed
# on each Mac mini). They do NOT change behavior unless uncommented —
# existing nodes see no change after pulling this template.
#
# Sidecar: default for /synthesize when ?backend= isn't sent.
# Back-compat: Go /api/v1/tts is hardcoded to "pocket" regardless of this.
# SIDECAR_TTS_DEFAULT_BACKEND=pocket
#
# Sidecar: default for /synthesize/stream. Only "pocket" is honored —
# anything else logs a startup warning and falls back to "pocket"
# (Kokoro has no streaming API in FluidAudio 0.15.5).
SIDECAR_TTS_STREAM_BACKEND=pocket

# ── Real-time streaming ASR engine (sidecar) ────────────────
# Default streaming engine for the realtime WS endpoints
# (/stream/realtime, /v2/listen, /v1/realtime). Only takes effect if
# uncommented. Valid values: eou-160, eou-320, eou-1280, nemotron-560,
# nemotron-1120, nemotron-2240, unified-320, unified-640, unified-1120,
# unified-2080. See docs/api.md § Real-Time Streaming ASR for details.
#
SIDECAR_REALTIME_ENGINE=eou-320

# ── Rate Limits (requests/minute) ──────────────────────────
# NOTE: enforced in-memory PER NODE. With N minis behind Caddy,
# effective limits are roughly N × these values.
RATE_LIMIT_FREE=20
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=0

# ── Prometheus Metrics ─────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ── Loki Logging (optional) ────────────────────────────────
# Point at a Loki reachable from this node (e.g. on the DB VM).
LOKI_ENABLED=false
LOKI_PUSH_URL=http://192.168.1.10:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_JOB=gotranscribesrv

# ── PII Redaction (Presidio runs per-node via compose) ─────
ENABLE_PII=true
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_TIMEOUT_MS=3000
PII_ENTITIES=
PII_SCORE_THRESHOLD=0.6

# ── Docker log rotation ────────────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
